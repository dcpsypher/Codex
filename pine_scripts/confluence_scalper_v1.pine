// ══════════════════════════════════════════════════════════════════════════════
// CONFLUENCE SCALPER v3 — 5m Donchian Breakout  |  Binance USDC Futures
// ══════════════════════════════════════════════════════════════════════════════
// Designed for: BTC/USDC, ETH/USDC, SOL/USDC — 5m timeframe
// Capital: $20 starting | Leverage: 10x
// Fee model: Limit entries/TP = 0% maker | Stop-market SL = 0.04% taker
//
// Entry stack (ALL must confirm):
//   Trend       — EMA 9 > EMA 21 (fast trend alignment)
//   Breakout    — Close breaks the highest high / lowest low of prior N bars
//   Momentum    — RSI not over-extended (exhaustion guard)
//   Volume      — Volume > threshold × Volume SMA
//
// Why breakout instead of pullback?
//   The v2 VWAP-bounce bought dips in an uptrend — anti-predictive in ranging
//   crypto (37-42% win rate). Breakouts enter when momentum is ACCELERATING, not
//   exhausting: price clearing the prior-N-bar range works in both trending and
//   range-expansion regimes, lifting win rate toward the 48-55% zone.
//
// Exits:
//   Take-profit — Limit order at 1.5× ATR (maker, 0% fee)
//   Stop-loss   — Stop-market at 1.0× ATR  (taker, 0.04% fee)
//   Time stop   — Flat after 12 bars (= 60 min) regardless
//   R:R = 1.5:1  →  breakeven win-rate ≈ 40%  (target ≥ 50%)
// ══════════════════════════════════════════════════════════════════════════════

//@version=6
strategy(
    title               = "Confluence Scalper v3 — 5m Donchian Breakout",
    shorttitle          = "CS_v3_5m",
    overlay             = true,
    initial_capital     = 20,
    default_qty_type    = strategy.percent_of_equity,
    default_qty_value   = 100,
    commission_type     = strategy.commission.percent,
    commission_value    = 0.04,
    slippage            = 1,
    calc_on_order_fills = true,
    pyramiding          = 0,
    max_bars_back       = 500
)

// ──────────────────────────────────────────────────────────────────────────────
// INPUTS
// ──────────────────────────────────────────────────────────────────────────────

// — Trend —
i_emaFast    = input.int(9,     "EMA Fast Length",          group = "Trend",            minval = 5)
i_emaSlow    = input.int(21,    "EMA Slow Length",          group = "Trend",            minval = 10)

// — Breakout —
i_breakoutLen = input.int(20,   "Breakout Lookback (bars)", group = "Breakout",         minval = 3,
     tooltip = "Close must break the highest high / lowest low of this many prior bars to trigger.")

// — Regime Filter —
i_adxLen     = input.int(14,    "ADX Length",               group = "Regime Filter",    minval = 2)
i_adxMin     = input.float(25,  "ADX Minimum",              group = "Regime Filter",    step = 1, minval = 0,
     tooltip = "Only trade breakouts when ADX is above this. Low ADX = chop, where breakouts whipsaw.")

// — Momentum —
i_rsiLen     = input.int(14,    "RSI Length",               group = "Momentum",         minval = 2)
i_rsiLongHi  = input.int(75,    "RSI Long Max",             group = "Momentum",         tooltip = "Don't buy breakouts above this RSI (too extended)")
i_rsiShortLo = input.int(25,    "RSI Short Min",            group = "Momentum",         tooltip = "Don't sell breakouts below this RSI (too extended)")

// — Volume —
i_volLen     = input.int(20,    "Volume SMA Length",        group = "Volume")
i_volMult    = input.float(1.2, "Volume Multiplier",        group = "Volume",           step = 0.1)

// — Risk Management —
i_atrLen     = input.int(14,    "ATR Length",               group = "Risk Management")
i_tpMult     = input.float(1.5, "TP ATR Multiplier",        group = "Risk Management",  step = 0.1,
     tooltip = "Take-profit = this × ATR. Default 1.5 gives 1.5:1 R:R vs 1× ATR stop-loss.")
i_slMult     = input.float(1.0, "SL ATR Multiplier",        group = "Risk Management",  step = 0.1,
     tooltip = "Stop-loss = this × ATR. 1× is tight but valid — entry is at VWAP support/resistance.")
i_limitOff   = input.float(0.02,"Limit Entry Offset %",     group = "Risk Management",  step = 0.01)
i_maxBars    = input.int(12,    "Max Bars in Trade (Time Stop)", group = "Risk Management",
     minval = 1, tooltip = "12 bars × 5m = 60-minute maximum hold time.")
i_leverage   = input.int(10,    "Display Leverage",         group = "Risk Management",  tooltip = "Informational only — set actual leverage on Binance")

// — Breakeven Trail —
i_beEnable   = input.bool(false,"Enable Breakeven Trail",   group = "Breakeven",
     tooltip = "OFF by default. When ON, moves SL to entry after price travels i_beTrigger fraction of the TP distance.")
i_beTrigger  = input.float(0.7, "BE Trigger (fraction of TP)", group = "Breakeven",
     step = 0.05, minval = 0.1, maxval = 1.0)

// ──────────────────────────────────────────────────────────────────────────────
// INDICATOR CALCULATIONS
// ──────────────────────────────────────────────────────────────────────────────

// Trend — EMA ribbon (fast for breakout responsiveness)
emaFast = ta.ema(close, i_emaFast)
emaSlow = ta.ema(close, i_emaSlow)
emaBull = emaFast > emaSlow
emaBear = emaFast < emaSlow

// Momentum — RSI (exhaustion guard only)
rsi = ta.rsi(close, i_rsiLen)

// Regime — ADX (trend strength)
[diPlus, diMinus, adxVal] = ta.dmi(i_adxLen, i_adxLen)
adxOk = adxVal > i_adxMin

// Volume confirmation
volSma = ta.sma(volume, i_volLen)
volOk  = volume > i_volMult * volSma

// ATR (dynamic SL/TP sizing)
atr = ta.atr(i_atrLen)

// ──────────────────────────────────────────────────────────────────────────────
// DONCHIAN BREAKOUT CONDITIONS  (prior-bar range, no lookahead)
// ──────────────────────────────────────────────────────────────────────────────

priorHigh = ta.highest(high, i_breakoutLen)[1]   // highest high of prior N bars
priorLow  = ta.lowest(low,  i_breakoutLen)[1]    // lowest  low  of prior N bars

breakoutLong  = close > priorHigh
breakoutShort = close < priorLow

// ──────────────────────────────────────────────────────────────────────────────
// ENTRY SIGNALS
// ──────────────────────────────────────────────────────────────────────────────

longSignal = emaBull                                        // EMA: fast uptrend
          and breakoutLong                                  // Break prior N-bar high
          and adxOk                                         // Regime: strong trend
          and rsi < i_rsiLongHi                             // RSI: not over-extended
          and volOk                                         // Volume: real participation
          and strategy.position_size == 0                   // No open position

shortSignal = emaBear
           and breakoutShort
           and adxOk
           and rsi > i_rsiShortLo
           and volOk
           and strategy.position_size == 0

// ──────────────────────────────────────────────────────────────────────────────
// ENTRY ORDERS — LIMIT (MAKER = 0% FEE ON BINANCE USDC PAIRS)
// ──────────────────────────────────────────────────────────────────────────────

longLimitPx  = close * (1 - i_limitOff / 100)
shortLimitPx = close * (1 + i_limitOff / 100)

if longSignal
    strategy.cancel("Short")
    strategy.entry("Long", strategy.long,  limit = longLimitPx, comment = "Breakout")

if shortSignal
    strategy.cancel("Long")
    strategy.entry("Short", strategy.short, limit = shortLimitPx, comment = "Breakdown")

// Cancel pending order if conditions flip before fill
if strategy.position_size == 0
    if not longSignal
        strategy.cancel("Long")
    if not shortSignal
        strategy.cancel("Short")

// ──────────────────────────────────────────────────────────────────────────────
// EXIT ORDERS — TP LIMIT (MAKER 0%) + SL STOP-MARKET (TAKER 0.04%)
// ──────────────────────────────────────────────────────────────────────────────

var float lTp   = na
var float lSl   = na
var float sTp   = na
var float sSl   = na
var int   barsIn = 0

if strategy.position_size != 0
    barsIn += 1
else
    barsIn := 0

if strategy.position_size > 0 and strategy.position_size[1] == 0
    lTp := strategy.position_avg_price + i_tpMult * atr
    lSl := strategy.position_avg_price - i_slMult * atr
    strategy.exit("Long Exit", from_entry = "Long",
         limit        = lTp,
         stop         = lSl,
         comment_profit = "Long TP",
         comment_loss   = "Long SL")

if strategy.position_size < 0 and strategy.position_size[1] == 0
    sTp := strategy.position_avg_price - i_tpMult * atr
    sSl := strategy.position_avg_price + i_slMult * atr
    strategy.exit("Short Exit", from_entry = "Short",
         limit        = sTp,
         stop         = sSl,
         comment_profit = "Short TP",
         comment_loss   = "Short SL")

// Breakeven trail (opt-in) — fires only after price has moved i_beTrigger × TP distance
if i_beEnable and strategy.position_size > 0 and not na(lSl) and not na(lTp)
    entryPx  = strategy.position_avg_price
    beLevel  = entryPx + i_beTrigger * (lTp - entryPx)
    if high >= beLevel and lSl < entryPx
        lSl := entryPx
        strategy.exit("Long Exit", from_entry = "Long",
             limit        = lTp,
             stop         = lSl,
             comment_profit = "Long TP",
             comment_loss   = "Long BE")

if i_beEnable and strategy.position_size < 0 and not na(sSl) and not na(sTp)
    entryPx  = strategy.position_avg_price
    beLevel  = entryPx - i_beTrigger * (entryPx - sTp)
    if low <= beLevel and sSl > entryPx
        sSl := entryPx
        strategy.exit("Short Exit", from_entry = "Short",
             limit        = sTp,
             stop         = sSl,
             comment_profit = "Short TP",
             comment_loss   = "Short BE")

// Time stop — flatten after maxBars candles (60 min at 5m default)
if strategy.position_size != 0 and barsIn >= i_maxBars
    strategy.close_all(comment = "Time Stop")
    strategy.cancel_all()

// ──────────────────────────────────────────────────────────────────────────────
// VISUAL — CHART OVERLAYS
// ──────────────────────────────────────────────────────────────────────────────

// EMA ribbon with fill
p_emaF = plot(emaFast, "EMA 9",  color = color.new(color.blue, 15),   linewidth = 1)
p_emaS = plot(emaSlow, "EMA 21", color = color.new(color.orange, 10), linewidth = 2)
fill(p_emaF, p_emaS,
     color = emaBull ? color.new(color.green, 90) : color.new(color.red, 90))

// Donchian breakout channel
plot(priorHigh, "Breakout High", color = color.new(color.teal, 25),   linewidth = 1)
plot(priorLow,  "Breakout Low",  color = color.new(color.maroon, 25), linewidth = 1)

// TP / SL level lines (visible only while in trade)
plot(strategy.position_size > 0 ? lTp : na, "Long TP",  color = color.new(color.green, 0), linewidth = 1, style = plot.style_linebr)
plot(strategy.position_size > 0 ? lSl : na, "Long SL",  color = color.new(color.red, 0),   linewidth = 1, style = plot.style_linebr)
plot(strategy.position_size < 0 ? sTp : na, "Short TP", color = color.new(color.green, 0), linewidth = 1, style = plot.style_linebr)
plot(strategy.position_size < 0 ? sSl : na, "Short SL", color = color.new(color.red, 0),   linewidth = 1, style = plot.style_linebr)

// Entry signal arrows
plotshape(longSignal,  "Long Entry",  shape.triangleup,   location.belowbar, color.new(color.lime, 0),  size = size.small)
plotshape(shortSignal, "Short Entry", shape.triangledown, location.abovebar, color.new(color.red, 0),   size = size.small)

// Trade background shading
bgcolor(strategy.position_size > 0 ? color.new(color.green, 94)
      : strategy.position_size < 0 ? color.new(color.red,   94)
      : na,
      title = "Position Background")

// ──────────────────────────────────────────────────────────────────────────────
// DASHBOARD TABLE  (top-right corner)
// ──────────────────────────────────────────────────────────────────────────────

var table dash = table.new(
     position     = position.top_right,
     columns      = 2,
     rows         = 13,
     bgcolor      = color.new(color.black, 70),
     border_color = color.new(color.gray, 50),
     border_width = 1,
     frame_color  = color.new(color.gray, 30),
     frame_width  = 1)

if barstate.islast
    ct      = strategy.closedtrades
    winPct  = ct > 0 ? strategy.wintrades / ct * 100 : 0.0
    lossAmt = math.abs(strategy.grossloss)
    pf      = strategy.grossprofit > 0 and lossAmt > 0 ? strategy.grossprofit / lossAmt : 0.0
    pnlClr  = strategy.netprofit >= 0 ? color.lime : color.red
    wrClr   = winPct >= 55 ? color.lime : winPct >= 45 ? color.yellow : color.red
    pfClr   = pf >= 1.5 ? color.lime : pf >= 1.0 ? color.yellow : color.red

    trendTxt = emaBull ? "BULLISH" : emaBear ? "BEARISH" : "NEUTRAL"
    trendClr = emaBull ? color.lime : emaBear ? color.red : color.gray
    boTxt    = close > priorHigh ? "BREAKOUT ↑" : close < priorLow ? "BREAKDOWN ↓" : "INSIDE RANGE"
    boClr    = close > priorHigh ? color.lime : close < priorLow ? color.red : color.gray

    table.cell(dash, 0, 0, "CS v3 — 5m Breakout",
         text_color = color.white, text_size = size.small,
         bgcolor = color.new(color.navy, 40))
    table.cell(dash, 1, 0, "Binance USDC Futures",
         text_color = color.yellow, text_size = size.tiny,
         bgcolor = color.new(color.navy, 40))

    table.cell(dash, 0, 1, "Net P&L",       text_color = color.silver, text_size = size.tiny)
    table.cell(dash, 1, 1, "$" + str.tostring(math.round(strategy.netprofit, 2)),
         text_color = pnlClr, text_size = size.tiny)

    table.cell(dash, 0, 2, "Equity",        text_color = color.silver, text_size = size.tiny)
    table.cell(dash, 1, 2, "$" + str.tostring(math.round(strategy.equity, 2)),
         text_color = color.white, text_size = size.tiny)

    table.cell(dash, 0, 3, "Win Rate",      text_color = color.silver, text_size = size.tiny)
    table.cell(dash, 1, 3, str.tostring(math.round(winPct, 1)) + "%",
         text_color = wrClr, text_size = size.tiny)

    table.cell(dash, 0, 4, "Profit Factor", text_color = color.silver, text_size = size.tiny)
    table.cell(dash, 1, 4, str.tostring(math.round(pf, 2)),
         text_color = pfClr, text_size = size.tiny)

    table.cell(dash, 0, 5, "Trades",        text_color = color.silver, text_size = size.tiny)
    table.cell(dash, 1, 5, str.tostring(ct), text_color = color.white, text_size = size.tiny)

    table.cell(dash, 0, 6, "Leverage",      text_color = color.silver, text_size = size.tiny)
    table.cell(dash, 1, 6, str.tostring(i_leverage) + "x",
         text_color = color.white, text_size = size.tiny)

    table.cell(dash, 0, 7, "Maker Fee",     text_color = color.silver, text_size = size.tiny)
    table.cell(dash, 1, 7, "0.00% (Limit)", text_color = color.lime,   text_size = size.tiny)

    table.cell(dash, 0, 8, "Taker Fee",     text_color = color.silver, text_size = size.tiny)
    table.cell(dash, 1, 8, "0.04% (SL)",    text_color = color.yellow, text_size = size.tiny)

    table.cell(dash, 0, 9,  "EMA Trend",    text_color = color.silver, text_size = size.tiny)
    table.cell(dash, 1, 9,  trendTxt,       text_color = trendClr,     text_size = size.tiny)

    table.cell(dash, 0, 10, "Breakout",     text_color = color.silver, text_size = size.tiny)
    table.cell(dash, 1, 10, boTxt,          text_color = boClr,        text_size = size.tiny)

    rsiTxt = "RSI " + str.tostring(math.round(rsi, 1))
    rsiClr = rsi > 70 ? color.red : rsi < 30 ? color.red : color.white
    table.cell(dash, 0, 11, "RSI",          text_color = color.silver, text_size = size.tiny)
    table.cell(dash, 1, 11, rsiTxt,         text_color = rsiClr,       text_size = size.tiny)

    adxTxt = str.tostring(math.round(adxVal, 1)) + (adxOk ? " ✓" : " ✗")
    adxClr = adxOk ? color.lime : color.gray
    table.cell(dash, 0, 12, "ADX",          text_color = color.silver, text_size = size.tiny)
    table.cell(dash, 1, 12, adxTxt,         text_color = adxClr,       text_size = size.tiny)
