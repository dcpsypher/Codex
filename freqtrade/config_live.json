{
  "$schema": "https://schema.freqtrade.io/schema.json",

  "_comment_safety": "KEEP dry_run: true for at least 2 weeks of paper trading before going live.",

  "max_open_trades": 1,
  "stake_currency": "USDC",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.95,
  "fiat_display_currency": "USD",

  "_comment_dryrun": "Set to false ONLY after 2+ weeks of profitable dry-run results.",
  "dry_run": true,
  "dry_run_wallet": 20,

  "cancel_open_orders_on_exit": true,

  "unfilledtimeout": {
    "_comment": "Cancel unfilled limit entries after 5 minutes so stale orders don't fill at wrong prices.",
    "entry": 5,
    "exit": 10,
    "unit": "minutes",
    "exit_timeout_count": 0
  },

  "trading_mode": "futures",
  "margin_mode": "isolated",
  "liquidation_buffer": 0.05,

  "leverage_config": {
    "_comment": "Sets leverage per pair. Start at 10x; increase only after 50+ live trades.",
    "BTC/USDC:USDC": 10,
    "ETH/USDC:USDC": 10,
    "SOL/USDC:USDC": 10
  },

  "exchange": {
    "name": "binance",
    "_comment_keys": "Add your API keys here directly on your machine. NEVER share keys in chat or commit them to git.",
    "_comment_perms": "Required permissions: Enable Reading + Enable Futures. Disable withdrawals.",
    "key": "YOUR_BINANCE_API_KEY",
    "secret": "YOUR_BINANCE_API_SECRET",
    "ccxt_config": {
      "enableRateLimit": true,
      "options": {
        "defaultType": "future"
      }
    },
    "ccxt_async_config": {
      "enableRateLimit": true,
      "rateLimit": 200
    },
    "pair_whitelist": [
      "BTC/USDC:USDC",
      "ETH/USDC:USDC",
      "SOL/USDC:USDC"
    ],
    "pair_blacklist": []
  },

  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },

  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },

  "fee": 0.0004,

  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],

  "bot_name": "ConfluenceScalper",
  "timeframe": "5m",

  "telegram": {
    "enabled": true,
    "_comment": "1) Go to @BotFather on Telegram → /newbot → copy the token below. 2) Message @userinfobot to get your chat_id.",
    "token": "YOUR_TELEGRAM_BOT_TOKEN",
    "chat_id": "YOUR_TELEGRAM_CHAT_ID",
    "notification_settings": {
      "status": "on",
      "warning": "on",
      "startup": "on",
      "entry": "on",
      "entry_fill": "on",
      "exit": {
        "roi": "on",
        "emergency_exit": "on",
        "force_exit": "on",
        "exit_signal": "on",
        "stop_loss": "on",
        "stoploss_on_exchange": "on",
        "custom_exit": "on"
      },
      "show_candle": "ohlc"
    }
  },

  "api_server": {
    "enabled": false,
    "_comment": "Enable for Freqtrade UI (FreqUI). Replace secrets before enabling.",
    "listen_ip_address": "127.0.0.1",
    "listen_port": 8080,
    "verbosity": "error",
    "enable_openapi": false,
    "jwt_secret_key": "REPLACE_WITH_RANDOM_32_CHAR_STRING",
    "CORS_origins": [],
    "username": "freqtrader",
    "password": "REPLACE_WITH_STRONG_PASSWORD"
  },

  "initial_state": "running",
  "force_entry_enable": false,
  "internals": {
    "process_throttle_secs": 5
  }
}
